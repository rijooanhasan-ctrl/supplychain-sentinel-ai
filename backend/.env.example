APP_NAME="SupplyChain Sentinel AI"
APP_ENV=development
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite:///./sentinel.db
DATA_SOURCE=demo
# ALERT_SURGE_RECENT_DAYS=14
# ALERT_SURGE_BASELINE_DAYS=28
# ALERT_SURGE_RATIO_MEDIUM=1.25
# ALERT_SURGE_RATIO_HIGH=1.50
# ALERT_QUALITY_REJECTION_THRESHOLD=0.02
# ALERT_DELAY_MIN_LATE_PROBABILITY=0.20
# ALERT_DELAY_MIN_DELIVERIES=10

# Display currency configuration
# DISPLAY_CURRENCY="USD" # Supported: "USD" (default) or "INR"
# USD_TO_INR_RATE=83.50 # Required if DISPLAY_CURRENCY is "INR", must be finite and > 0

# Web CSV data import configuration
# ENABLE_WEB_IMPORT=false # Set to true to enable web CSV upload
# IMPORT_MAX_FILE_BYTES=5242880 # 5 MB max per file
# IMPORT_MAX_FILES=11 # Maximum number of CSV files per upload
# IMPORT_MAX_TOTAL_BYTES=26214400 # 25 MB max total upload size
# UPLOAD_DB_PATH=backend/data/uploaded.db # SQLite database path for uploaded data

# Environment file override (optional, defaults to .env)
# ENV_FILE=.env
